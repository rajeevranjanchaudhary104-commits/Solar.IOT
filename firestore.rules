rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // System Owner / Administrator
    function isOwnerAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'sushilnisha23112004@gmail.com' ||
         request.auth.token.email == 'rajeevranjanchaudhary104@gmail.com' ||
         request.auth.token.email == 'devapaliwal1234@gmail.com' ||
         request.auth.token.email == 'arjunparth0001@gmail.com');
    }

    // Research Mode: Student slots, Teacher slots, School name and address
    match /solar_iot/research_data {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // Hardware configuration: Firmware code, pin layout, and sensor specifications
    match /solar_iot/hardware_config {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // 20 Customizable slots for arbitrary project parameters
    match /solar_iot/custom_slots {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // About section content (photos, videos, summary):
    match /solar_iot/about_content {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // Solar Buy Links & Sizing Presets (Luminous, Tata, Waaree, Loom Solar):
    match /solar_iot/buy_links {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // Solar Store Settings & Custom Products catalog:
    match /solar_iot/store_settings {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    match /solar_iot/store_products {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // Solar telemetry document (node_01) and security_system document:
    // Device/ESP32 writes sensor data and security alerts, and operators trigger cleaning/servo commands
    match /solar_iot/{deviceId} {
      allow read: if true;
      allow write: if true;
    }

    // Historical telemetry logs (time series)
    match /solar_iot/{deviceId}/history/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Security system camera telemetry, alerts, and motion events
    match /security_system/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Cleaning logs
    match /cleaning_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // User settings & custom calculation saved presets
    match /user_presets/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // User profile: Weather location (State, District, Area) & ESP32 login connection data
    match /user_profiles/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Community & User Reviews (open for anyone to submit reviews):
    match /user_reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isOwnerAdmin();
    }
  }
}
